#!/usr/bin/env bash
# bt — launch Claude Code on one of several accounts, session-wide.
#
#   bt <n> [claude args...]   launch on account n; n=1 is the default ~/.claude
#   bt                        show each account's email, login status, and last
#                             use, then suggest a run seat
#
# Accounts 2..N are Claude Code config dirs at ~/.claude-accounts/<n>
# (CLAUDE_CONFIG_DIR is the mechanism Claude Code documents for this). Each
# dir needs one browser /login the first time; symlink CLAUDE.md and
# settings.json to the ~/.claude copies so every account behaves the same.
# Account 1 stays the interactive seat; the no-arg call suggests the
# least-recently-used other account for a run.
#
# Install: symlink this file onto PATH, e.g.
#   ln -s "$(pwd)/scripts/bt" ~/.local/bin/bt
#
# Optional config at ~/.claude-accounts/bt.conf, one directive per line:
#   accounts <N>                  highest account number (default 4)
#   beads <path-prefix> <dir>     export BEADS_DIR=<dir> when the session
#                                 starts under <path-prefix>, so satellite
#                                 repos share one work graph
set -euo pipefail

ACCOUNTS_DIR="$HOME/.claude-accounts"
LOG="$ACCOUNTS_DIR/usage.log"
CONF="$ACCOUNTS_DIR/bt.conf"
MAX_ACCOUNT=4

read_conf() {
  [ -f "$CONF" ] || return 0
  while read -r key a b; do
    case "$key" in
      accounts) MAX_ACCOUNT=$a ;;
      beads)
        case "$PWD" in
          "${a/#\~/$HOME}"*) export BEADS_DIR="${b/#\~/$HOME}" ;;
        esac ;;
    esac
  done < "$CONF"
}

account_json() {
  if [ "$1" = 1 ]; then echo "$HOME/.claude.json"; else echo "$ACCOUNTS_DIR/$1/.claude.json"; fi
}

# Claude Code rewrites the account's .claude.json during any session, so its
# mtime is real last activity — bt's own log only sees bt launches.
last_used_epoch() {
  local f; f=$(account_json "$1")
  [ -f "$f" ] || { echo 0; return; }
  stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo 0
}

account_email() {
  local f; f=$(account_json "$1")
  [ -f "$f" ] || return 0
  grep -o '"emailAddress" *: *"[^"]*"' "$f" | head -1 | cut -d'"' -f4 || true
}

suggest() {
  echo "bt — launch Claude Code on one of $MAX_ACCOUNT accounts: bt <1..$MAX_ACCOUNT> [claude args...]"
  echo
  printf '%-8s %-36s %-12s %s\n' "account" "email" "status" "last used"
  local n email status ts last cwd
  for n in $(seq 1 "$MAX_ACCOUNT"); do
    email=$(account_email "$n")
    if [ -n "$email" ]; then status="logged in"; else email="-"; status="needs login"; fi
    ts=$(last_used_epoch "$n")
    if [ "$ts" -gt 0 ]; then last=$(date -r "$ts" '+%Y-%m-%dT%H:%M:%S'); else last=never; fi
    cwd=$(grep "^account=$n " "$LOG" 2>/dev/null | tail -1 \
      | sed -e 's/.* cwd=//' -e "s|^$HOME|~|" || true)
    printf '%-8s %-36s %-12s %s%s\n' "$n" "$email" "$status" "$last" "${cwd:+  $cwd}"
  done
  echo
  local best= best_ts=9999999999 ts
  for n in $(seq 2 "$MAX_ACCOUNT"); do
    [ -n "$(account_email "$n")" ] || continue
    ts=$(last_used_epoch "$n")
    if [ "$ts" -lt "$best_ts" ]; then best=$n; best_ts=$ts; fi
  done
  if [ -n "$best" ]; then
    echo "suggestion: interactive work on 1; start this run on $best (least recently used logged-in account)"
  else
    echo "no other account is logged in yet: run bt <n>, then /login inside the session"
  fi
  exit 0
}

read_conf
[ $# -eq 0 ] && suggest

n=$1; shift
if ! [ "$n" -ge 1 ] 2>/dev/null || [ "$n" -gt "$MAX_ACCOUNT" ]; then
  echo "usage: bt <1..$MAX_ACCOUNT> [claude args...]" >&2
  exit 2
fi

mkdir -p "$ACCOUNTS_DIR"
printf 'account=%s %s cwd=%s\n' "$n" "$(date +%Y-%m-%dT%H:%M:%S)" "$PWD" >> "$LOG"

if [ "$n" = "1" ]; then
  exec claude "$@"
fi
export CLAUDE_CONFIG_DIR="$ACCOUNTS_DIR/$n"
exec claude "$@"
