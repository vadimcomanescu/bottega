#!/usr/bin/env python3
"""bt — launch Claude Code on one of several accounts, session-wide.

  bt                    dashboard: every account's login state, weekly and
                        model-scoped usage, last activity, and a suggested
                        run seat
  bt <n> [claude ...]   launch Claude Code on account n; 1 is ~/.claude
  bt add                create the next account dir, ready for /login
  bt rm <n> [-y]        delete an account dir; -y skips the confirmation
  bt mesh               point existing accounts at the shared sessions dir

Account 1 is ~/.claude; every other account is a Claude Code config dir
at ~/.claude-accounts/<n> (CLAUDE_CONFIG_DIR is the mechanism Claude Code
documents for this), and the account list is whatever dirs exist there.
bt add creates the dir and symlinks CLAUDE.md, settings.json, and
sessions to the ~/.claude copies so every account behaves the same; the
first session on it needs one browser /login. Account 1 stays the
interactive seat; the dashboard suggests the least-recently-used other
account for a run.

The sessions symlink is what lets sessions on different accounts see
each other: session records all land in ~/.claude/sessions, so one
account's session can discover and message another's. bt mesh migrates
accounts created before that symlink existed — per account, it moves any
*.json out of a real sessions dir into ~/.claude/sessions, replaces the
dir with the symlink, prints what it did, and is safe to re-run.

Usage numbers are fetched live per account from the endpoint /usage
itself uses, authenticated with the account's own stored OAuth token
(macOS Keychain, or .credentials.json in the config dir elsewhere).
When a fetch fails — offline, expired token — the dashboard falls back
to the numbers the account's last session cached, marked with ~ so
stale data never reads as current. A cached window whose reset time has
passed shows 0%: no session ran after the cache was written, so nothing
was spent since the reset.

Install (the repo is private, so the download authenticates through the
GitHub CLI, which every bottega machine already has logged in):
  gh api -H "Accept: application/vnd.github.raw" \
    "repos/vadimcomanescu/bottega/contents/scripts/bt?ref=main" \
    > ~/.local/bin/bt && chmod +x ~/.local/bin/bt
Update by re-running the same line. Needs python3 on PATH.

Optional config at ~/.claude-accounts/bt.conf, one directive per line
(unknown directives are ignored):
  beads <path-prefix> <dir>     export BEADS_DIR=<dir> when the session
                                starts under <path-prefix>, so satellite
                                repos share one work graph
"""

import concurrent.futures
import getpass
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request
from datetime import datetime

HOME = os.path.expanduser("~")
ACCOUNTS_DIR = os.path.join(HOME, ".claude-accounts")
LOG = os.path.join(ACCOUNTS_DIR, "usage.log")
CONF = os.path.join(ACCOUNTS_DIR, "bt.conf")
SESSIONS_DIR = os.path.join(HOME, ".claude", "sessions")

EMAIL_MAX = 34
BAR_WIDTH = 10

COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ

ACCENT, BOLD, DIM = "38;5;173", "1", "38;5;245"
GREEN, YELLOW, RED = "38;5;71", "38;5;179", "38;5;167"


def c(code, s):
    return f"\x1b[{code}m{s}\x1b[0m" if COLOR else s


def read_conf():
    if not os.path.isfile(CONF):
        return
    with open(CONF) as f:
        for line in f:
            parts = line.split()
            if len(parts) >= 3 and parts[0] == "beads":
                prefix = os.path.expanduser(parts[1])
                if os.getcwd().startswith(prefix):
                    os.environ["BEADS_DIR"] = os.path.expanduser(parts[2])


def discover_accounts():
    """Account 1 plus every numeric dir under ~/.claude-accounts, sorted."""
    ns = [1]
    try:
        for name in os.listdir(ACCOUNTS_DIR):
            if (name.isdigit() and int(name) > 1
                    and os.path.isdir(os.path.join(ACCOUNTS_DIR, name))):
                ns.append(int(name))
    except OSError:
        pass
    return sorted(ns)


def account_json(n):
    if n == 1:
        return os.path.join(HOME, ".claude.json")
    return os.path.join(ACCOUNTS_DIR, str(n), ".claude.json")


def config_dir(n):
    if n == 1:
        return os.path.join(HOME, ".claude")
    return os.path.join(ACCOUNTS_DIR, str(n))


USAGE_URL = "https://api.anthropic.com/api/oauth/usage"


def access_token(n):
    """The account's OAuth access token, from wherever Claude Code keeps it,
    or None when it is missing or already expired.

    macOS: a Keychain entry whose service name carries the first 8 hex chars
    of the config dir's sha256 (none for the default ~/.claude, whose service
    name is shared with an MCP-tokens entry — the username qualifier picks
    the right one). Elsewhere: .credentials.json inside the config dir."""
    creds = None
    if sys.platform == "darwin":
        service = "Claude Code-credentials"
        if n != 1:
            digest = hashlib.sha256(config_dir(n).encode()).hexdigest()
            service += "-" + digest[:8]
        for cmd in (["security", "find-generic-password", "-s", service,
                     "-a", getpass.getuser(), "-w"],
                    ["security", "find-generic-password", "-s", service, "-w"]):
            try:
                out = subprocess.run(cmd, capture_output=True, text=True,
                                     timeout=5)
                if out.returncode == 0:
                    found = json.loads(out.stdout).get("claudeAiOauth")
                    if found and found.get("accessToken"):
                        creds = found
                        break
            except (OSError, ValueError, subprocess.TimeoutExpired):
                pass
    else:
        try:
            with open(os.path.join(config_dir(n), ".credentials.json")) as f:
                creds = json.load(f).get("claudeAiOauth")
        except (OSError, ValueError):
            pass
    if not creds or not creds.get("accessToken"):
        return None
    expires_ms = creds.get("expiresAt") or 0
    if expires_ms and expires_ms / 1000 < time.time() + 60:
        return None
    return creds["accessToken"]


def fetch_usage(n):
    """Live /usage data for one account, or None when it can't be had."""
    token = access_token(n)
    if not token:
        return None
    req = urllib.request.Request(USAGE_URL, headers={
        "Authorization": f"Bearer {token}",
        "anthropic-beta": "oauth-2025-04-20",
    })
    try:
        with urllib.request.urlopen(req, timeout=4) as r:
            return json.load(r)
    except (OSError, ValueError):
        return None


def parse_limits(limits):
    """(weekly, scoped) windows out of a /usage limits list, cached or live."""
    weekly = scoped = None
    now = datetime.now().astimezone()
    for lim in limits or []:
        resets = None
        if lim.get("resets_at"):
            try:
                resets = datetime.fromisoformat(lim["resets_at"]).astimezone()
            except ValueError:
                pass
        rolled = resets is not None and resets < now
        window = {
            "pct": 0 if rolled else round(lim.get("percent") or 0),
            "resets": resets,
            "rolled": rolled,
        }
        if lim.get("kind") == "weekly_all":
            weekly = window
        elif lim.get("kind") == "weekly_scoped" and not scoped:
            model = ((lim.get("scope") or {}).get("model") or {})
            window["label"] = (model.get("display_name") or "scoped").lower()
            scoped = window
    return weekly, scoped


def load_account(n):
    """Everything the dashboard shows for one account, from its .claude.json.

    Claude Code rewrites that file during any session, so its mtime is real
    last activity — bt's own log only sees bt launches. Usage windows here
    are the cached fallback; the dashboard overlays live data on top."""
    info = {"n": n, "email": None, "mtime": 0, "weekly": None, "scoped": None,
            "live": False}
    path = account_json(n)
    try:
        with open(path) as f:
            raw = json.load(f)
    except (OSError, ValueError):
        return info
    info["mtime"] = os.path.getmtime(path)
    info["email"] = (raw.get("oauthAccount") or {}).get("emailAddress")
    limits = ((raw.get("cachedUsageUtilization") or {})
              .get("utilization") or {}).get("limits")
    info["weekly"], info["scoped"] = parse_limits(limits)
    return info


def last_cwd(n):
    try:
        with open(LOG) as f:
            lines = [l for l in f if l.startswith(f"account={n} ")]
    except OSError:
        return None
    if not lines or " cwd=" not in lines[-1]:
        return None
    cwd = lines[-1].rsplit(" cwd=", 1)[1].strip()
    return cwd.replace(HOME, "~", 1)


def rel_time(ts):
    if not ts:
        return "never"
    s = time.time() - ts
    if s < 90:
        return "just now"
    if s < 3600:
        return f"{int(s // 60)} min ago"
    if s < 86400:
        return f"{int(s // 3600)} h ago"
    if s < 172800:
        return "yesterday"
    if s < 604800:
        return f"{int(s // 86400)} days ago"
    d = datetime.fromtimestamp(ts)
    return f"{d:%b} {d.day}"


def day(dt):
    return f"{dt:%a} {dt:%b} {dt.day}"


def bar(pct):
    """(plain, colored) rendering of one usage bar."""
    filled = round(min(max(pct, 0), 100) * BAR_WIDTH / 100)
    tone = GREEN if pct < 50 else YELLOW if pct < 80 else RED
    plain = "█" * filled + "░" * (BAR_WIDTH - filled)
    return plain, c(tone, "█" * filled) + c(DIM, "░" * (BAR_WIDTH - filled))


def dashboard():
    numbers = discover_accounts()
    accounts = [load_account(n) for n in numbers]

    logged_in = [a for a in accounts if a["email"]]
    with concurrent.futures.ThreadPoolExecutor(len(logged_in) or 1) as pool:
        live = dict(zip((a["n"] for a in logged_in),
                        pool.map(fetch_usage, (a["n"] for a in logged_in))))
    for a in accounts:
        data = live.get(a["n"])
        if data:
            a["weekly"], a["scoped"] = parse_limits(data.get("limits"))
            a["live"] = True

    scoped_label = next(
        (a["scoped"]["label"] for a in accounts if a["scoped"]), "scoped")

    # Each cell is (plain, colored): widths come from the plain text so
    # ANSI codes never skew the alignment.
    def cell(text, code=None):
        return (text, c(code, text) if code else text)

    def usage(window, stale):
        if not window:
            return cell("—", DIM)
        plain_bar, colored_bar = bar(window["pct"])
        mark = "~" if stale else " "
        pct = f"{window['pct']:>3}%"
        return (f"{plain_bar} {mark}{pct}",
                f"{colored_bar} {c(DIM, mark)}{pct}")

    def resets(a):
        window = a["weekly"] or a["scoped"]
        if not window or not window["resets"]:
            return cell("—", DIM)
        d = day(window["resets"])
        return cell(f"reset {d}" if window["rolled"] else d, DIM)

    rows = []
    for a in accounts:
        if a["email"]:
            email = a["email"]
            if len(email) > EMAIL_MAX:
                email = email[:EMAIL_MAX - 1] + "…"
            stale = not a["live"]
            row = [cell(str(a["n"]), BOLD), cell(email),
                   usage(a["weekly"], stale), usage(a["scoped"], stale),
                   resets(a), cell(rel_time(a["mtime"]), DIM)]
        else:
            row = [cell(str(a["n"]), BOLD), cell("not logged in", DIM)] + \
                  [cell("—", DIM)] * 3 + [cell(rel_time(a["mtime"]), DIM)]
        cwd = last_cwd(a["n"])
        row.append(cell(cwd, DIM) if cwd else cell(""))
        rows.append(row)

    header = [cell(h, DIM) for h in
              ("#", "account", "weekly", scoped_label, "resets", "last used")]
    widths = [max([len(header[i][0])] + [len(r[i][0]) for r in rows])
              for i in range(6)]

    def emit(row):
        out = "  " + "  ".join(
            row[i][1] + " " * (widths[i] - len(row[i][0])) for i in range(6))
        if len(row) > 6 and row[6][0]:
            out += "  " + row[6][1]
        print(out.rstrip())

    print()
    print(f"  {c(ACCENT, '✻')} {c(BOLD, 'bt')} — Claude Code accounts")
    print()
    emit(header)
    print("  " + "  ".join(c(DIM, "─" * widths[i]) for i in range(6)))
    for row in rows:
        emit(row)
    print()
    if any(a["email"] and not a["live"] and (a["weekly"] or a["scoped"])
           for a in accounts):
        note = ("~ cached from that account's last session "
                "(token expired or offline; a session on it refreshes)")
        print(f"  {c(DIM, note)}")
        print()

    candidates = [a for a in accounts if a["n"] > 1 and a["email"]]
    if candidates:
        best = min(candidates, key=lambda a: a["mtime"])["n"]
        print(f"  {c(ACCENT, '➜')} interactive work on 1 · start runs on "
              f"{c(BOLD, best)} {c(DIM, '(least recently used)')}")
    else:
        print(f"  {c(ACCENT, '➜')} no other account is logged in yet — "
              f"bt add, then /login inside its session")
    print(f"    {c(DIM, 'bt <n> [claude args…] launches · bt add · bt rm <n> · bt mesh · bt --help')}")
    print()


def link_shared(path):
    """Point one account dir at the ~/.claude copies every account shares.

    CLAUDE.md and settings.json make the account behave like account 1.
    sessions is the cross-account one: every session record lands in the
    one directory, so a session on any account can discover and message
    a session on any other."""
    for name in ("CLAUDE.md", "settings.json"):
        src = os.path.join(HOME, ".claude", name)
        link = os.path.join(path, name)
        if os.path.exists(src) and not os.path.lexists(link):
            os.symlink(src, link)
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    link = os.path.join(path, "sessions")
    if not os.path.lexists(link):
        os.symlink(SESSIONS_DIR, link)


def add_account():
    numbers = discover_accounts()
    n = next(i for i in range(2, max(numbers) + 2) if i not in numbers)
    path = os.path.join(ACCOUNTS_DIR, str(n))
    os.makedirs(path)
    link_shared(path)
    print(f"account {n} created — run: bt {n}, then /login inside the session")


def mesh_accounts():
    """Give every existing account the shared sessions dir. Re-runnable."""
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    for n in discover_accounts():
        if n == 1:
            continue
        path = os.path.join(config_dir(n), "sessions")
        if os.path.islink(path):
            print(f"account {n}: already meshed")
            continue
        if os.path.isfile(path):
            print(f"bt: account {n}: {path} is a file, left alone",
                  file=sys.stderr)
            continue
        moved = 0
        if os.path.isdir(path):
            for name in sorted(os.listdir(path)):
                if not name.endswith(".json"):
                    continue
                target = os.path.join(SESSIONS_DIR, name)
                if os.path.exists(target):
                    stem, ext = os.path.splitext(name)
                    target = os.path.join(SESSIONS_DIR, f"{stem}-acct{n}{ext}")
                shutil.move(os.path.join(path, name), target)
                moved += 1
            kept = os.listdir(path)
            if kept:
                print(f"bt: account {n}: moved {moved} session files, kept "
                      f"{path} because {len(kept)} other entries are in it",
                      file=sys.stderr)
                continue
            os.rmdir(path)
        os.symlink(SESSIONS_DIR, path)
        carried = f"moved {moved} session files, " if moved else ""
        print(f"account {n}: {carried}sessions now links to {SESSIONS_DIR}")


def remove_account(n, force):
    if n == 1:
        print("bt: account 1 is ~/.claude, not bt's to remove", file=sys.stderr)
        sys.exit(2)
    path = os.path.join(ACCOUNTS_DIR, str(n))
    if not os.path.isdir(path):
        print(f"bt: no account {n} at {path}", file=sys.stderr)
        sys.exit(2)
    who = load_account(n)["email"] or "not logged in"
    if not force:
        if not sys.stdin.isatty():
            print(f"bt: not a terminal — use: bt rm {n} -y", file=sys.stderr)
            sys.exit(2)
        answer = input(f"remove account {n} ({who}) — deletes {path} [y/N] ")
        if answer.strip().lower() not in ("y", "yes"):
            print("kept")
            return
    shutil.rmtree(path)
    print(f"account {n} removed ({who})")


def launch(n, args):
    os.makedirs(ACCOUNTS_DIR, exist_ok=True)
    with open(LOG, "a") as f:
        stamp = datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
        f.write(f"account={n} {stamp} cwd={os.getcwd()}\n")
    if n != 1:
        os.environ["CLAUDE_CONFIG_DIR"] = os.path.join(ACCOUNTS_DIR, str(n))
    try:
        os.execvp("claude", ["claude"] + args)
    except FileNotFoundError:
        print("bt: claude not found on PATH", file=sys.stderr)
        sys.exit(127)


def usage_error():
    numbers = " ".join(str(n) for n in discover_accounts())
    print(f"usage: bt [<n> [claude args...] | add | rm <n> [-y] | mesh]\n"
          f"accounts: {numbers} (bt add creates one)", file=sys.stderr)
    sys.exit(2)


def main():
    read_conf()
    args = sys.argv[1:]
    if not args:
        dashboard()
        return
    if args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    if args[0] == "add":
        add_account()
        return
    if args[0] == "mesh":
        mesh_accounts()
        return
    if args[0] in ("rm", "remove"):
        rest = [a for a in args[1:] if a not in ("-y", "--yes")]
        if len(rest) != 1 or not rest[0].isdigit():
            usage_error()
        remove_account(int(rest[0]), force=len(rest) != len(args[1:]))
        return
    try:
        n = int(args[0])
    except ValueError:
        usage_error()
    if n not in discover_accounts():
        usage_error()
    launch(n, args[1:])


if __name__ == "__main__":
    main()
